{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SSMC",
  "version": "0.1.3",
  "identifier": "com.ssmc.app",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SSMC",
        "width": 960,
        "height": 700,
        "resizable": true,
        "maximizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZBODQyODhFRDQzNzEzMEQKUldRTkV6ZlVqaWlFK3VkNjA4Z2FpVExkMTVFZGVidXpBUWVaOU5RUEY0K0VxRCtzZFNHRzRNeTIK",
      "endpoints": [
        "https://github.com/madeByNuke/Minecraft-Server-Simulator/releases/latest/download/latest.json",
        "https://noblecratemc.com/updates/ssmc/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
